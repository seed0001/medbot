# --- Admin ---
# The account with this email gets the Admin tab (site-wide key/model/persona).
ADMIN_EMAIL=travisbollenbach@gmail.com

# --- OpenRouter (optional here) ---
# The admin normally sets the key, model, and persona in the Admin tab.
# These env vars are just fallbacks. Get a key at https://openrouter.ai/keys
#OPENROUTER_API_KEY=sk-or-...
#OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Fish Audio voice replies (optional; admin tab is the normal place) ---
#FISH_AUDIO_API_KEY=...
#FISH_TTS_MODEL=s2.1-pro-free

# --- Email (required for 2-hour follow-up reminders and "email my log") ---
# Any SMTP provider: Gmail app password, Resend, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="MedBot <you@gmail.com>"

# --- Deployment ---
# Public URL of the app; used in reminder emails. Set to your Railway domain.
APP_URL=http://localhost:3000
# Railway volume mount path so the SQLite database survives deploys (e.g. /data)
# DATA_DIR=/data

# Minutes until the follow-up reminder after each reading (default 120)
FOLLOWUP_MINUTES=120

# IANA timezone used for appointments and reports (IMPORTANT on Railway, whose
# servers run in UTC — set this to the user's home timezone)
TIMEZONE=America/Chicago

PORT=3000
